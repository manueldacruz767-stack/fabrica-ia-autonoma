            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-his"
          },
          "expr": "((sum(rate(http_requests_total{status=~\"5..\"}[5m])) or sum(rate(his_erros_total[5m]))) / clamp_min(sum(rate(http_requests_total[5m])) or sum(rate(his_requisicoes_total[5m])), 1)) * 100",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "title": "Taxa de erros 5xx",
      "type": "timeseries"
    },
